{
  "initialize_request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "protocolVersion": "2024-11-05",
      "capabilities": {},
      "clientInfo": {"name": "mcp-inspector-mock", "version": "0.9.0"}
    }
  },
  "tools_list_request": {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "tools/list",
    "params": {}
  },
  "valid_call_requests": [
    {
      "case_id": "mul_explicit_args",
      "request": {
        "jsonrpc": "2.0",
        "id": 10,
        "method": "tools/call",
        "params": {
          "name": "good_calc",
          "arguments": {"op": "mul", "a": 12.5, "b": 4}
        }
      },
      "expected_value": 50.0
    },
    {
      "case_id": "add_default_b",
      "request": {
        "jsonrpc": "2.0",
        "id": 11,
        "method": "tools/call",
        "params": {
          "name": "good_calc",
          "arguments": {"op": "add", "a": 9.5}
        }
      },
      "expected_value": 10.5
    }
  ],
  "invalid_call_requests": [
    {
      "case_id": "invalid_enum_op",
      "reason": "op 传入了枚举列表外的 pow",
      "request": {
        "jsonrpc": "2.0",
        "id": 20,
        "method": "tools/call",
        "params": {
          "name": "good_calc",
          "arguments": {"op": "pow", "a": 2, "b": 3}
        }
      }
    },
    {
      "case_id": "wrong_type_string_num",
      "reason": "a 传入了字符串而非数字",
      "request": {
        "jsonrpc": "2.0",
        "id": 21,
        "method": "tools/call",
        "params": {
          "name": "good_calc",
          "arguments": {"op": "add", "a": "twelve", "b": 3}
        }
      }
    },
    {
      "case_id": "bool_masquerading_as_number",
      "reason": "Python 中 bool 是 int 子类，JSON Schema number 必须拒绝 true/false",
      "request": {
        "jsonrpc": "2.0",
        "id": 22,
        "method": "tools/call",
        "params": {
          "name": "good_calc",
          "arguments": {"op": "add", "a": true, "b": 1}
        }
      }
    },
    {
      "case_id": "out_of_bounds_maximum",
      "reason": "a 超出 FieldSpec 设定的 1000000 上限",
      "request": {
        "jsonrpc": "2.0",
        "id": 23,
        "method": "tools/call",
        "params": {
          "name": "good_calc",
          "arguments": {"op": "mul", "a": 99999999, "b": 2}
        }
      }
    },
    {
      "case_id": "missing_required_a",
      "reason": "缺少必填字段 a",
      "request": {
        "jsonrpc": "2.0",
        "id": 24,
        "method": "tools/call",
        "params": {
          "name": "good_calc",
          "arguments": {"op": "sub"}
        }
      }
    }
  ],
  "domain_error_request": {
    "case_id": "division_by_zero",
    "request": {
      "jsonrpc": "2.0",
      "id": 30,
      "method": "tools/call",
      "params": {
        "name": "good_calc",
        "arguments": {"op": "div", "a": 10, "b": 0}
      }
    }
  }
}
