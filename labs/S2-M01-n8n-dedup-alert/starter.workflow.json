[
  {
    "id": "intel-daily-digest-main",
    "name": "Competitor & Industry Intel Stream (Starter Baseline)",
    "active": false,
    "settings": {
      "executionOrder": "v1",
      "timezone": "UTC",
      "errorWorkflow": ""
    },
    "nodes": [
      {
        "id": "node-schedule-1",
        "name": "Schedule Trigger",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          220,
          300
        ],
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "0 8 * * *"
              }
            ]
          }
        }
      },
      {
        "id": "node-rss-a",
        "name": "RSS Read Competitor Feed",
        "type": "n8n-nodes-base.rssFeedRead",
        "typeVersion": 1.1,
        "position": [
          440,
          220
        ],
        "parameters": {
          "url": "https://intel.example.com/competitor/rss.xml"
        }
      },
      {
        "id": "node-rss-b",
        "name": "RSS Read Policy Feed",
        "type": "n8n-nodes-base.rssFeedRead",
        "typeVersion": 1.1,
        "position": [
          440,
          380
        ],
        "parameters": {
          "url": "https://policy.example.org/industry/rss.xml"
        }
      },
      {
        "id": "node-llm-1",
        "name": "LLM Intel Summary",
        "type": "@n8n/n8n-nodes-langchain.openAi",
        "typeVersion": 1.4,
        "continueOnFail": true,
        "position": [
          700,
          300
        ],
        "parameters": {
          "model": "mini-instruct",
          "responseFormat": "text",
          "systemPrompt": "请把输入的竞品动态与行业政策通知总结一下。"
        }
      },
      {
        "id": "node-webhook-push",
        "name": "Push Intel Digest Webhook",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          960,
          300
        ],
        "parameters": {
          "method": "POST",
          "url": "https://webhook.site/00000000-0000-0000-0000-000000000001"
        }
      }
    ],
    "connections": {
      "Schedule Trigger": {
        "main": [
          [
            {
              "node": "RSS Read Competitor Feed",
              "type": "main",
              "index": 0
            },
            {
              "node": "RSS Read Policy Feed",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "RSS Read Competitor Feed": {
        "main": [
          [
            {
              "node": "LLM Intel Summary",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "RSS Read Policy Feed": {
        "main": [
          [
            {
              "node": "LLM Intel Summary",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "LLM Intel Summary": {
        "main": [
          [
            {
              "node": "Push Intel Digest Webhook",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
  },
  {
    "id": "intel-digest-error-alert",
    "name": "Intel Stream Error Alert Workflow (TODO Stub)",
    "active": false,
    "settings": {
      "executionOrder": "v1",
      "timezone": "UTC"
    },
    "nodes": [],
    "connections": {}
  }
]
