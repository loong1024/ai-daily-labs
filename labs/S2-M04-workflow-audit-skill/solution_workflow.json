{
  "workflow_name": "vip-incident-compensation-mailer",
  "purpose": "接收工单系统告警 Webhook，调用 LLM 生成致歉信与补偿方案，向受影响企业客户群发补偿邮件并发放代金券（不可逆外部动作）。",
  "triggers": [
    {
      "id": "trig_webhook_01",
      "type": "webhook",
      "path": "/hooks/incident-closed",
      "filter": "event.type == 'incident.closed' && event.source != 'compensation_bot'",
      "deduplicate_by_event_id": true,
      "writeback_updates_source_ticket": false
    },
    {
      "id": "trig_cron_02",
      "type": "schedule",
      "cron": "0 9 * * 1",
      "timezone": "Asia/Shanghai"
    }
  ],
  "data_flow": {
    "pagination": true,
    "null_handling": "explicit_null_and_timezone_norm",
    "malformed_record_policy": "log_to_error_table"
  },
  "nodes": [
    {
      "id": "node_llm_draft",
      "type": "llm_completion",
      "model": "gpt-4o-mini",
      "structured_output": true,
      "fallback_category": "其他",
      "validation_max_retries": 2,
      "on_validation_exhausted": "route_to_human_review"
    },
    {
      "id": "node_send_compensation",
      "type": "external_side_effect",
      "actions": ["send_bulk_email", "issue_compensation_voucher"],
      "idempotency_key": "${incident_id}:${customer_id}",
      "credentials": {
        "provider": "mail_voucher_gateway",
        "api_key": "${MAIL_VOUCHER_GATEWAY_API_KEY}",
        "scope": "compensation_sender_minimal"
      },
      "retry": {
        "enabled": true,
        "strategy": "exponential_backoff_with_jitter",
        "max_attempts": 4,
        "jitter": true,
        "retry_on": ["429", "500", "502", "503", "504", "timeout"],
        "non_retryable": ["400", "401", "403", "422"],
        "dead_letter_queue": "dlq_vip_compensation",
        "alert_on_dead_letter": true
      },
      "human_approval": {
        "enabled": true,
        "timeout_policy": "abort",
        "timeout_hours": 24,
        "auth_required": true,
        "one_time_token": true
      }
    }
  ],
  "governance": {
    "redact_logs": true,
    "max_budget_usd_per_run": 5.0,
    "budget_alert_threshold_pct": 80,
    "max_loop_iterations": 200
  }
}
